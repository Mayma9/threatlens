# Normalize line endings: LF in the repository, Windows checkouts stay usable.
* text=auto

# Files executed inside Linux containers or Git Bash must keep LF.
*.sh       text eol=lf
*.py       text eol=lf
*.sql      text eol=lf
*.tsv      text eol=lf
Dockerfile text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.docx binary
*.pdf  binary
*.pbix binary
*.joblib binary
