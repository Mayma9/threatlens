# Copy this file to .env (never commit .env) and replace every "change-me".

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=threatlens
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only account used by Power BI Desktop on the "dw" schema
POWERBI_READER_PASSWORD=change-me

# --- CTI sources (Sprint 2) ---
NVD_API_KEY=
ABUSECH_AUTH_KEY=
